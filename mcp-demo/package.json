{
  "name": "@zohairhussain/local-demo-mcp",
  "version": "1.0.1",
  "description": "Modular TypeScript MCP server for inspecting GitHub repositories and serving project notes",
  "main": "./dist/index.js",
  "bin": {
    "local-demo-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "github",
    "stdio",
    "typescript",
    "model-context-protocol"
  ],
  "author": "Zohair313",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zohair313/Mcp-Server.git",
    "directory": "mcp-demo"
  },
  "bugs": {
    "url": "https://github.com/Zohair313/Mcp-Server/issues"
  },
  "homepage": "https://github.com/Zohair313/Mcp-Server#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}