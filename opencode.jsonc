{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "local-demo-mcp": {
      "type": "local",
      "command": [
        "npx",
        "--yes",
        "@zohairhussain/local-demo-mcp@1.0.6"
      ],
      "enabled": true,
      "environment": {
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
      }
    }
  }
}
